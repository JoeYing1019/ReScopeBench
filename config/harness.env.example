# Copy to harness.env, fill in, then `set -a; . config/harness.env; set +a` before running.
# Keys are not written here: inject OPENAI_API_KEY (or the credentials file) the way the release README says.

# ---- model API (frozen into run-plan.json at `prepare`; use a new --output to change them)
# openai-chat | openai-responses | anthropic-messages | gemini-generate-content
RESCOPE_MODEL_API=openai-chat
# Endpoint for every API goes in the release's OPENAI_BASE_URL; the harness strips a trailing /v1.
#   openai-chat / openai-responses   https://api.openai.com/v1 (or any OpenAI-compatible server)
#   anthropic-messages               https://api.anthropic.com/v1
#   gemini-generate-content          https://generativelanguage.googleapis.com/v1
RESCOPE_PROVIDER_PROTOCOL=openai
OPENAI_BASE_URL=https://your-provider.example/v1
# Gemini only. api-key sends x-goog-api-key (Gemini API). For Vertex AI use bearer with an access
# token as the key, and point the URL at your project:
# RESCOPE_GEMINI_AUTH=bearer
# RESCOPE_GEMINI_URL=https://us-central1-aiplatform.googleapis.com/v1/projects/MY_PROJECT/locations/us-central1/publishers/google/models/{model}:{method}
RESCOPE_GEMINI_AUTH=api-key
# Extra request fields merged over the defaults, e.g. {"thinking_level": "high"} or {"reasoning_effort": "high"}.
RESCOPE_MODEL_PARAMS='{}'
# One model request; the defaults are 60 (openai-chat), 600 (openai-responses), 900 (anthropic, gemini).
RESCOPE_REQUEST_TIMEOUT_SECONDS=600

# ---- sandbox for the Hermes worker
# docker (default) | <your implemented remote provider>
RESCOPE_SANDBOX=docker
# Optional patched image, built locally by hermes_image/build_local.sh:
# RESCOPE_SANDBOX_IMAGE=rescopebench-harness:local
# Remote options are supplied by the user, not included in this release.
# Per-sandbox request; default comes from the release's docker --cpus / --memory.
# RESCOPE_SANDBOX_CPU=1000m
# RESCOPE_SANDBOX_MEMORY=4096Mi
# A module that calls providers.register_provider(...) at import, for RESCOPE_SANDBOX=<your provider>.
# RESCOPE_SANDBOX_PLUGIN=my_sandbox_plugin

# ---- smoke tests: stop run-arm after N tasks (the run stays resumable)
# RESCOPE_LIMIT=1
